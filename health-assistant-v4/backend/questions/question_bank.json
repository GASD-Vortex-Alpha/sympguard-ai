{
  "_meta": {
    "note": "Curated, deterministic follow-up questions -- no LLM required to generate or select these. Each topic is triggered when one of its trigger_symptoms is present in the symptoms extracted from the user's initial free-text description (see nlp_extraction.py). Questions are deduplicated by id if more than one triggered topic shares a question. 'if_yes_signal' / 'if_answer_signal' text is fed into the safety engine's final validation pass verbatim -- it must exactly match (or closely match, since matching is order-independent/negation-aware) a phrase the safety engine recognizes, see backend/safety/red_flag_engine.py.",
    "question_types": "yes_no | choice | scale"
  },
  "max_questions_per_session": 6,
  "questions_per_batch": 2,
  "generic_intro_questions": [
    {
      "id": "onset_timing",
      "prompt": "When did this start?",
      "type": "choice",
      "options": [
        "Within the last hour",
        "Today",
        "1-3 days ago",
        "More than 3 days ago",
        "More than 2 weeks ago"
      ]
    },
    {
      "id": "overall_severity",
      "prompt": "How severe would you say it is right now?",
      "type": "choice",
      "options": [
        "Mild - barely noticeable",
        "Moderate - noticeable, manageable",
        "Severe - hard to ignore or function"
      ]
    }
  ],
  "topics": [
    {
      "topic_id": "headache",
      "trigger_symptoms": [
        "headache",
        "severe headache",
        "throbbing pain",
        "migraine",
        "tension headache"
      ],
      "priority_order": [
        "headache_onset_speed",
        "headache_worst_ever",
        "headache_vision",
        "headache_fever",
        "headache_vomiting",
        "headache_neck_stiff",
        "headache_injury"
      ],
      "questions": [
        {
          "id": "headache_onset_speed",
          "prompt": "Did the headache come on suddenly (seconds to minutes) or gradually (over hours)?",
          "type": "choice",
          "options": [
            "Suddenly",
            "Gradually"
          ],
          "if_answer_signal": {
            "Suddenly": "sudden severe headache"
          }
        },
        {
          "id": "headache_worst_ever",
          "prompt": "Is this the worst headache you have ever had?",
          "type": "yes_no",
          "critical": true,
          "critical_answer": "Yes",
          "if_yes_signal": "worst headache of my life"
        },
        {
          "id": "headache_vision",
          "prompt": "Any vision changes -- blurred, double, or loss of vision?",
          "type": "yes_no",
          "if_yes_signal": "vision changes"
        },
        {
          "id": "headache_fever",
          "prompt": "Do you also have a fever?",
          "type": "yes_no",
          "if_yes_signal": "fever"
        },
        {
          "id": "headache_vomiting",
          "prompt": "Any vomiting along with the headache?",
          "type": "yes_no",
          "if_yes_signal": "vomiting"
        },
        {
          "id": "headache_neck_stiff",
          "prompt": "Any stiffness in your neck?",
          "type": "yes_no",
          "if_yes_signal": "stiff neck"
        },
        {
          "id": "headache_injury",
          "prompt": "Any recent head injury or fall?",
          "type": "yes_no"
        }
      ]
    },
